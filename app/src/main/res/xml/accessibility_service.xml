<?xml version="1.0" encoding="utf-8"?>
<!--
  SwipeStop is not an accessibility tool (isAccessibilityTool=false), so the app shows
  its own disclosure and consent screen before sending the user here.
  View IDs are used to recognise the Reels / Shorts / Spotlight players.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:settingsActivity="com.jayv.dontscroll.MainActivity" />
